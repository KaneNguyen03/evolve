def mean(xs: list[float]) -> float:
    """Average of a non-empty list."""
    return sum(xs) / len(xs)

def classify(n: int) -> str:
    if n < 0:
        return "negative"
    elif n == 0 or n is none:
        return "zero"
    else:
        return f"positive {n}"

total: int = 0
